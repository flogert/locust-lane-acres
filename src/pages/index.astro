---
import SiteLayout from "../layouts/SiteLayout.astro";

---

<SiteLayout
	title="Locust Lane Acres | Fresh Eggs in Littlestown, PA"
	description="Locust Lane Acres is a small family farm in Littlestown, Pennsylvania, raising hens on a plant based diet for clean, fresh eggs."
>
	<div class="page-shell">
		<header class="site-header">
			<a class="brand" href="/" aria-label="Locust Lane Acres home">
				<img class="brand-logo" src="/locustlogo.png" alt="" width="140" height="140" />
				<span class="brand-title">Locust Lane Acres</span>
			</a>
		</header>

		<main class="farm-info" id="main-content" tabindex="-1" aria-labelledby="farm-heading">
			<h1 id="farm-heading" class="sr-only">Locust Lane Acres</h1>
			<p class="farm-info__lede">
				Nestled in the small town of Littlestown, we offer delicious, high quality,
				naturally raised chicken eggs for your restaurant, store or large quantity
				purchase.
			</p>

			<hr class="farm-info__divider" aria-hidden="true" />

			<ul class="farm-info__benefits" aria-label="Feed and quality highlights">
				<li>Soy Free</li>
				<li>Corn Free</li>
				<li>Non GMO</li>
				<li>100% Natural</li>
				<li>Plant Based Feed</li>
			</ul>

			<figure class="farm-info__photo">
				<img
					src="/Use this Chicken pic.png"
					alt="Brown hens inside the Locust Lane Acres chicken house"
					width="640"
					height="542"
				/>
			</figure>

			<h2 class="farm-info__heading">Taste the difference!</h2>
			<p class="farm-info__support">
				Hens fed with plant based feed produce eggs rich in nutrients and a clean,
				better tasting finish.
			</p>
		</main>

		<footer class="site-footer">
			<div class="site-footer__brand">
				<span class="site-footer__name">Locust Lane Acres</span>
				<p class="site-footer__motto">
					Simply, a better tasting egg.
					<img class="site-footer__egg" src="/egg art.png" alt="" aria-hidden="true" width="16" height="18" />
				</p>
			</div>
			<p class="site-footer__note">
				We keep it pretty simple. If you like what you see, leave us a message and
				we'll call ya back.
			</p>
			<address class="site-footer__contact">
				<span>399 Locust Lane, Littlestown, PA 17340</span>
				<a href="tel:17173590035">717.359.0035</a>
			</address>
		</footer>
	</div>
</SiteLayout>
